{
  "version": 1,
  "items": [
    {
      "id": "tests-pass",
      "label": "Tests pass",
      "check": "command",
      "command": "npm test",
      "required": true,
      "appliesTo": ["implementation", "bugfix"],
      "autoDetect": true
    },
    {
      "id": "typescript-compiles",
      "label": "TypeScript compiles",
      "check": "command",
      "command": "npx tsc --noEmit",
      "required": true,
      "appliesTo": ["implementation"],
      "autoDetect": true
    },
    {
      "id": "committed",
      "label": "Work committed to git",
      "check": "command",
      "command": "git diff --quiet && git diff --cached --quiet",
      "required": true,
      "appliesTo": ["*"]
    },
    {
      "id": "on-branch",
      "label": "On feature branch (not main)",
      "check": "command",
      "command": "branch=$(git branch --show-current) && test -n \"$branch\" && test \"$branch\" != 'main'",
      "required": true,
      "appliesTo": ["*"]
    },
    {
      "id": "code-review",
      "label": "Code review dispatched",
      "check": "transcript",
      "pattern": "code.review|code-reviewer|code_reviewer",
      "required": true,
      "appliesTo": ["implementation"]
    }
  ],
  "overrides": {
    "disable": [],
    "requireAll": false
  }
}
