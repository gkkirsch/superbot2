{
  "name": "Goals",
  "description": "Track and manage goals across all spaces",
  "version": "0.1.0",
  "scope": "space",
  "icon": "target",

  "card": {
    "dataSource": "data.jsonl",
    "renderer": "goal-tracker",
    "itemSchema": {
      "title": { "type": "string", "label": "Goal" },
      "status": { "type": "string", "label": "Status" },
      "progress": { "type": "string", "label": "Progress" },
      "dueDate": { "type": "string", "label": "Due date" },
      "notes": { "type": "string", "label": "Notes", "multiline": true },
      "space": { "type": "string", "label": "Space" }
    },
    "display": {
      "title": "title",
      "body": "notes",
      "subtitle": "space",
      "meta": "progress"
    },
    "statusFlow": ["active", "paused", "completed", "abandoned"],
    "defaultFilter": { "status": "active" },
    "actions": [
      {
        "id": "complete",
        "label": "Complete",
        "icon": "check",
        "style": "primary",
        "handler": "set-status",
        "params": { "status": "completed" }
      },
      {
        "id": "pause",
        "label": "Pause",
        "icon": "pause",
        "style": "secondary",
        "handler": "set-status",
        "params": { "status": "paused" }
      },
      {
        "id": "update",
        "label": "Update",
        "icon": "pen-line",
        "style": "secondary",
        "handler": "edit-field",
        "params": { "field": "notes" }
      }
    ]
  },

  "settings": {
    "schema": {
      "checkSources": {
        "type": "string",
        "enum": ["all", "spaces-only", "manual-only"],
        "label": "Progress check sources",
        "description": "What to review when checking goal progress",
        "default": "all"
      },
      "autoAddNotes": {
        "type": "boolean",
        "label": "Auto-add progress notes",
        "description": "Automatically append progress notes during scheduled checks",
        "default": true
      }
    }
  },

  "schedule": {
    "default": {
      "times": ["00:00", "06:00", "12:00", "18:00"],
      "days": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]
    },
    "configurable": true
  },

  "orchestrator": {
    "heartbeat": "Check active goals for progress. Review recent task completions and escalation resolutions in each space with active goals. Update goal notes with progress summaries. Flag any goals that are stalled or past due.",
    "priority": "medium"
  },

  "agent": {
    "type": "space-worker",
    "model": "haiku"
  }
}
